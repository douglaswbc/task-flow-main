# =============================================================================
# Task Flow - Environment Variables
# =============================================================================
# Copie este arquivo para .env.local e preencha com seus valores.
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# Frontend (Vite) - expostas ao bundle do cliente
# ---------------------------------------------------------------------------

# Google Gemini API Key (obrigatória)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase - URL do projeto e chave anônima (pública)
# Encontre em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Evolution API (WhatsApp) - URL, chave e webhook
VITE_EVO_API_URL=https://evo.your-instance.com
VITE_EVO_API_KEY=your_evo_api_key_here
VITE_WEBHOOK_URL_WHATSAPP=https://your-webhook-url.com/webhook

# =============================================================================
# Supabase Edge Functions (Deno)
# Configure estas variáveis no Supabase Dashboard:
#   Supabase Dashboard > Project Settings > Edge Functions
# Ou no arquivo supabase/.env (se usando CLI local)
# =============================================================================

# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# EVO_API_URL=https://evo.your-instance.com
# EVO_API_KEY=your_evo_api_key_here
